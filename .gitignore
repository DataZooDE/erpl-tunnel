# Credentials — never commit
.env
.env.*
.adt.creds
*credentials*.json
*secret*.json
!*_secret.cpp
!*_secret.hpp

# Generated IDoc corpus (perf/compat fixtures; regenerate via scripts/gen_idoc_corpus.sh)
corpus/

# Go mesh shim build artifacts (rebuilt by CMake from shim/*/*.go)
shim/*/*_shim.so
shim/*/*_shim.h
shim/spike_dlopen
# `go build ./...` in a shim directory drops a plain executable named after the
# package (shim/ts/ts, shim/nb/nb). They are ~84MB, unreferenced — the real shim is
# built by CMake with -buildmode=c-shared — and were committed by accident once.
shim/ts/ts
shim/nb/nb

# NetBird Tier 2 test artifacts (regenerated by the seeder / compose)
test/integration/netbird/mgmt-data/
test/integration/netbird/seeder/seeder
test/integration/netbird/.env
test/integration/headscale/.env

# Codex delegation data
.codex-delegate/
.codex/
