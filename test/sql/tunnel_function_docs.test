# name: test/sql/tunnel_function_docs.test
# description: Every function erpl_tunnel registers documents itself in duckdb_functions()
# group: [tunnel]

require erpl_tunnel

statement ok
LOAD erpl_tunnel

# ============================================================================
# Pragmas carry descriptions
#
# This is the non-obvious part. ExtensionLoader exposes no RegisterFunction
# overload taking a CreatePragmaFunctionInfo, which is why extensions generally
# assume pragmas cannot be documented -- but CreatePragmaFunctionInfo derives
# from CreateFunctionInfo and duckdb_functions() extracts PRAGMA_FUNCTION_ENTRY
# through the same generic path as every other function type.
#
# If this test ever goes red, the assumption is wrong and the pragma
# documentation across erpl and erpl-web needs revisiting, not just this repo.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_type = 'pragma'
  AND function_name IN ('tunnel_import', 'tunnel_create', 'tunnel_export',
                        'tunnel_close', 'tunnel_close_all')
  AND description IS NOT NULL AND description <> '';
----
5

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_type = 'pragma'
  AND function_name IN ('tunnel_import', 'tunnel_create', 'tunnel_export',
                        'tunnel_close', 'tunnel_close_all')
  AND len(examples) > 0;
----
5

# ============================================================================
# Positional parameters are named
#
# tunnel_close is the one pragma with a positional argument, so it is the one
# that needs parameter_names. Everything else takes named parameters, which
# DuckDB already reports correctly -- and which setting parameter_names would
# CLOBBER, since a non-empty parameter_names replaces the whole list and pads
# any shortfall with col1, col2. That is why the other pragmas deliberately set
# no parameter_names at all.
# ============================================================================

query I
SELECT parameters FROM duckdb_functions()
WHERE function_name = 'tunnel_close' AND function_type = 'pragma';
----
[tunnel_id]

# The named-parameter pragmas must still report their real names, not col0.
query I
SELECT list_contains(parameters, 'secret') AND NOT list_contains(parameters, 'col0')
FROM duckdb_functions()
WHERE function_name = 'tunnel_import' AND function_type = 'pragma';
----
true

query I
SELECT list_contains(parameters, 'local_port') AND NOT list_contains(parameters, 'col0')
FROM duckdb_functions()
WHERE function_name = 'tunnel_export' AND function_type = 'pragma';
----
true

# ============================================================================
# No function this extension registers is left undocumented
#
# Enumerated, not allow-listed. An allow-list of names passes green while the
# functions it forgets to mention stay undocumented -- which is exactly what
# happened elsewhere in the fleet.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE (function_name LIKE 'tunnel%' OR function_name = 'tunnels')
  AND (description IS NULL OR description = ''
       OR len(examples) = 0
       OR len(categories) = 0
       OR list_contains(parameters, 'col0'));
----
0
