# name: test/sql/tunnel_secret_aliases.test
# description: Friendly SSH aliases host/user/port normalise to ssh_host/ssh_user/ssh_port,
#              so both spellings work (usability). No server needed.
# group: [tunnel]

require erpl_tunnel

# Short, friendly spelling.
statement ok
CREATE SECRET s_short (TYPE ssh_tunnel, host 'bastion.example.com', user 'jump', port 2222, password 'pw');

# Stored under the canonical ssh_* keys.
query I
SELECT secret_string LIKE '%ssh_host=bastion.example.com%'
   AND secret_string LIKE '%ssh_user=jump%'
   AND secret_string LIKE '%ssh_port=2222%'
FROM duckdb_secrets() WHERE name = 's_short';
----
true

# The verbose spelling still works and is equivalent.
statement ok
CREATE SECRET s_long (TYPE ssh_tunnel, ssh_host 'bastion.example.com', ssh_user 'jump', ssh_port 2222, password 'pw');

query I
SELECT secret_string LIKE '%ssh_host=bastion.example.com%' AND secret_string LIKE '%ssh_user=jump%'
FROM duckdb_secrets() WHERE name = 's_long';
----
true
