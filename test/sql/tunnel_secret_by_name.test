# name: test/sql/tunnel_secret_by_name.test
# description: A tunnel pragma must use the secret NAMED in `secret=`, not an
#              arbitrary one. Secrets are created with no scope, so a path-based
#              lookup matched them all equally and picked whichever came first.
# group: [tunnel]

require erpl_tunnel

# --- two tunnel secrets, deliberately different backends -------------------
statement ok
CREATE SECRET s_ssh (TYPE ssh_tunnel, host 'bastion.invalid', user 'jump', password 'pw');

statement ok
CREATE SECRET s_mesh (TYPE tunnel, backend 'tailscale', auth_key 'tskey-auth-fake', hostname 'h');

# Naming the SSH secret must route down the SSH path. If name resolution is
# broken it silently picks the mesh secret and the error mentions Tailscale
# instead — the tell that a different secret than the one named was used.
statement error
PRAGMA tunnel_export(secret='s_ssh', local_port=9494);
----
SSH remote-forward export is not implemented yet

# And the reverse: naming the mesh secret must not land on the SSH path.
statement error
PRAGMA tunnel_export(secret='s_mesh', local_port=9494, remote_host='1.2.3.4');
----
remote_host applies only to the ssh backend

# Same for the import direction, which has the identical resolution path: the
# named SSH secret must produce an SSH failure (unreachable host), never a mesh one.
statement error
PRAGMA tunnel_import(secret='s_ssh', remote_host='h', remote_port='80', local_port='9098');
----
could not resolve SSH host
