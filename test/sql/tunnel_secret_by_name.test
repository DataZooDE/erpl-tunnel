# name: test/sql/tunnel_secret_by_name.test
# description: A tunnel pragma must use the secret NAMED in `secret=`, not an
#              arbitrary one. Secrets are created with no scope, so a path-based
#              lookup matched them all equally and picked whichever came first —
#              with two secrets defined, `secret='a'` could silently use secret 'b'
#              (different host, credentials, even backend) and nothing warned.
# group: [tunnel]

require erpl_tunnel

# Deliberately build-independent: the release pipeline runs every test/sql/*.test
# against the musl SSH-ONLY artifact too, where the mesh branch is compiled out and
# a mesh secret quietly falls through to the SSH path. So the discriminator below
# keys on secret CONTENT (which host gets dialled), not on which backend branch is
# taken. Mesh-branch assertions live in tunnel_export_mesh.test.

# --- two tunnel secrets, deliberately different backends -------------------
statement ok
CREATE SECRET s_ssh (TYPE ssh_tunnel, host 'bastion.invalid', user 'jump', password 'pw');

statement ok
CREATE SECRET s_mesh (TYPE tunnel, backend 'tailscale', auth_key 'tskey-auth-fake', hostname 'h');

# Naming the SSH secret must dial ITS host. If name resolution is broken and the
# mesh secret comes back instead, that secret has no ssh_host at all and the error
# names something else — so the hostname in this message is the proof.
statement error
PRAGMA tunnel_import(secret='s_ssh', remote_host='h', remote_port='80', local_port='9098');
----
bastion.invalid

# A name matching neither secret must fail as missing, not fall back to one of the
# two defined above.
statement error
PRAGMA tunnel_import(secret='does_not_exist', remote_host='h', remote_port='80', local_port='9098');
----
not found
