# name: test/sql/tunnel_loopback_bind.test
# description: FR-2/ADR-006 — the local listener binds 127.0.0.1 by default (security
#              fix over erpl's INADDR_ANY), and 0.0.0.0 only on explicit opt-in.
#              Real SSH server required (docker sshd); self-skips without env.
# group: [tunnel]

require erpl_tunnel

require-env ERPL_SSH_HOST

require-env ERPL_SSH_PORT

require-env ERPL_SSH_USER

require-env ERPL_SSH_PASSWORD

statement ok
CREATE SECRET loopback_secret (
    TYPE ssh_tunnel, ssh_host '${ERPL_SSH_HOST}', ssh_port '${ERPL_SSH_PORT}',
    ssh_user '${ERPL_SSH_USER}', password '${ERPL_SSH_PASSWORD}', auth_method 'password'
);

# Default: loopback bind.
statement ok
PRAGMA tunnel_create(secret='loopback_secret', remote_host='http-service',
    remote_port='8000', local_port='9060', timeout='30');

query I
SELECT bind_addr FROM tunnels() WHERE local_port = 9060;
----
127.0.0.1

# Explicit opt-in: all interfaces.
statement ok
PRAGMA tunnel_create(secret='loopback_secret', remote_host='http-service',
    remote_port='8000', local_port='9061', timeout='30', bind_all=true);

query I
SELECT bind_addr FROM tunnels() WHERE local_port = 9061;
----
0.0.0.0

statement ok
PRAGMA tunnel_close_all;

query I
SELECT count(*) FROM tunnels();
----
0
