# name: test/sql/tunnel_secret_redaction.test
# description: FR-22 / NFR-5 — every sensitive secret field is redacted in the secret
#              display; the real values never appear. Security-relevant, no server needed.
# group: [tunnel]

require erpl_tunnel

# A mesh secret with a sensitive auth key.
statement ok
CREATE SECRET red_ts (TYPE tunnel, backend 'tailscale',
    auth_key 'tskey-auth-SUPERSECRET-abc123', hostname 'node-a');

# A NetBird secret with a setup key.
statement ok
CREATE SECRET red_nb (TYPE tunnel, backend 'netbird',
    setup_key 'NBSETUP-SUPERSECRET-xyz789', hostname 'node-a');

# An SSH secret with password + key material.
statement ok
CREATE SECRET red_ssh (TYPE ssh_tunnel, ssh_host 'h', ssh_user 'u',
    password 'PW-SUPERSECRET', passphrase 'PP-SUPERSECRET',
    private_key_path '/keys/SECRET-id_rsa');

# auth_key redacted AND the real value absent.
query I
SELECT secret_string LIKE '%auth_key=redacted%'
   AND secret_string NOT LIKE '%SUPERSECRET%'
FROM duckdb_secrets() WHERE name = 'red_ts';
----
true

# setup_key redacted AND the real value absent.
query I
SELECT secret_string LIKE '%setup_key=redacted%'
   AND secret_string NOT LIKE '%SUPERSECRET%'
FROM duckdb_secrets() WHERE name = 'red_nb';
----
true

# password, passphrase, and private_key_path all redacted; no secret material leaks.
query I
SELECT secret_string LIKE '%password=redacted%'
   AND secret_string LIKE '%passphrase=redacted%'
   AND secret_string LIKE '%private_key_path=redacted%'
   AND secret_string NOT LIKE '%SUPERSECRET%'
FROM duckdb_secrets() WHERE name = 'red_ssh';
----
true
