# Custom SSH daemon configuration for testing
Port 22
Protocol 2
# One fixed host key (committed test fixture, see docker-compose.yml), so the
# host_key_fingerprint tests can pin it. Its fingerprint is
# SHA256:ATJVJJo261pwXqvVsiQkDjp1txG4h5V/rAtC0Q9nQo8 (ED25519).
HostKey /etc/ssh/ssh_host_test_ed25519_key

# Authentication settings - more permissive for testing
MaxAuthTries 100
MaxSessions 20
ClientAliveInterval 60
ClientAliveCountMax 3

# Allow root login with password for testing
PermitRootLogin yes
PasswordAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes

# Logging
SyslogFacility AUTH
LogLevel INFO

# Allow all users and hosts for testing
AllowUsers root
PermitEmptyPasswords no

# Session settings
X11Forwarding yes
X11DisplayOffset 10
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes

# Accept locale-related environment variables
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server 